{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/auth-config.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
